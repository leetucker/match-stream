    given-names: Lee
    email: lee.c.tucker@census.gov
license: MIT
repository-code: "https://github.com/leetucker/match-stream"
url: "https://github.com/leetucker/match-stream"
keywords:
  - econometrics
  - matching
  - propensity score
  - treatment effects
